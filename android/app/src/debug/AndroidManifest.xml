<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application>
        <!-- LeakCanary registers a second launcher icon ("leaks") in debug builds.
             Remove the alias so only the app icon shows; leak detection still works
             via LeakActivity (notification/tap). Release builds don't include LeakCanary. -->
        <activity-alias
            android:name="leakcanary.internal.activity.LeakLauncherActivity"
            tools:node="remove" />
    </application>
</manifest>
