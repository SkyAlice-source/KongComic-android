<?xml version="1.0" encoding="utf-8"?>
<paths>
    <cache-path
        name="update_apk"
        path="update/" />
    <!-- 更新 APK 自 v1.3.2 起保存在 App.dataPath（getFilesDir）下的 update/ 目录，
         不再是 cache 目录。缺少 files-path 时 FileProvider.getUriForFile 会抛
         "Failed to find configured root"，导致下载完成后系统安装器拉不起来。 -->
    <files-path
        name="update_apk_files"
        path="update/" />
    <external-files-path
        name="update_apk_external"
        path="update/" />
    <!-- Android 9 及以下的手动安装兜底会把 APK 复制到公共 Download 目录
         （Environment#getExternalStoragePublicDirectory）再用 FileProvider 暴露，
         需要 external-path 指向公共存储根。Android 10+ 走 MediaStore，不依赖此项。 -->
    <external-path
        name="public_download"
        path="Download/" />
</paths>
